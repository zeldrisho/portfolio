{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio-db","database_id": "ee37c96c-b5ed-49a4-bee5-e6aeeec15243",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "portfolio-bucket","preview_bucket_name": "portfolio-bucket",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
